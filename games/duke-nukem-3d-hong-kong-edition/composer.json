{
    "name": "jumphp-games/duke-nukem-3d-hong-kong-edition",
    "description": "Duke Nukem 3D Hong Kong edition",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../engine"
        },
        {
            "type": "vcs",
            "url": "https://github.com/davidnurdin/php-wasm-network"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
